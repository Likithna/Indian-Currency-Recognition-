# Streamlit secrets template.
#
# 1. Get a free Gemini API key: https://aistudio.google.com/apikey
# 2. Copy this file to secrets.toml (same folder) and paste your real key in.
# 3. Add secrets.toml to .gitignore — NEVER commit a real API key to GitHub.
#
# For Streamlit Community Cloud deployment: don't upload secrets.toml at
# all. Instead paste this same content (with your real key) into your
# app's dashboard under Settings -> Secrets.

GEMINI_API_KEY = "your-gemini-api-key-here"
